# 本机启动使用的 MySQL 配置；Docker 固定使用容器内主机 mysql。
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=smart_medical
# 留空时生成随机签名密钥，并保存在 instance 目录或容器持久化卷。
SECRET_KEY=

# AI 服务；留空密钥时仍可使用登录、患者和病历功能。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Docker 本地演示配置，可按需修改。
DOCKER_HTTP_PORT=8080
DOCKER_ADMIN_USERNAME=admin
DOCKER_ADMIN_PASSWORD=Admin123456
DOCKER_MYSQL_ROOT_PASSWORD=medical-root-local
DOCKER_MYSQL_USER=medical_app
DOCKER_MYSQL_PASSWORD=medical-app-local
DOCKER_MYSQL_DATABASE=smart_medical

